{
  "uid": "pas-overview",
  "title": "Predictive autoscaling",
  "tags": [
    "pas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "lane",
        "label": "Lane",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "multi": true,
        "includeAll": true,
        "query": {
          "query": "label_values(demo_requests_received_total, namespace)",
          "refId": "lane"
        },
        "refresh": 2
      },
      {
        "name": "per_pod_rps",
        "label": "Per-pod RPS",
        "type": "textbox",
        "query": "20",
        "current": {
          "value": "20",
          "text": "20"
        }
      },
      {
        "name": "slo_p95_ms",
        "label": "SLO p95 (ms)",
        "type": "textbox",
        "query": "300",
        "current": {
          "value": "300",
          "text": "300"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Offered load vs forecast (RPS)",
      "description": "Offered RPS counted on arrival at demo-api, and the forecaster's output that drives KEDA.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace) (rate(demo_requests_received_total{namespace=~\"$lane\"}[1m]))",
          "legendFormat": "{{namespace}} offered",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (lane) (pas_predicted_rps{lane=~\"$lane\"})",
          "legendFormat": "{{lane}} predicted (lead window)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (lane) (pas_forecast_rps{lane=~\"$lane\", horizon=\"1\"})",
          "legendFormat": "{{lane}} forecast t+1",
          "refId": "C"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Ready vs required replicas",
      "description": "Required = ceil(offered RPS / per-pod capacity). Ready below required means under-provisioned.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace) (kube_deployment_status_replicas_ready{namespace=~\"$lane\", deployment=\"demo-api\"})",
          "legendFormat": "{{namespace}} ready",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace) (kube_deployment_spec_replicas{namespace=~\"$lane\", deployment=\"demo-api\"})",
          "legendFormat": "{{namespace}} desired",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ceil(sum by (namespace) (rate(demo_requests_received_total{namespace=~\"$lane\"}[1m])) / $per_pod_rps)",
          "legendFormat": "{{namespace}} required",
          "refId": "C"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "description": "Client-side (k6) latency is the primary measure; server-side excludes queueing before the handler.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(demo_http_request_duration_seconds_bucket{namespace=~\"$lane\"}[1m])))",
          "legendFormat": "{{namespace}} server p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (lane) (k6_http_req_duration_p95{lane=~\"$lane\", status=\"200\"})",
          "legendFormat": "{{lane}} client p95 (k6)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($slo_p95_ms / 1000)",
          "legendFormat": "SLO",
          "refId": "C"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Error rate (k6)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (lane) (rate(k6_http_reqs_total{lane=~\"$lane\", status!~\"2..\"}[1m])) or sum by (lane) (rate(k6_http_reqs_total{lane=~\"$lane\"}[1m])) * 0) / sum by (lane) (rate(k6_http_reqs_total{lane=~\"$lane\"}[1m]))",
          "legendFormat": "{{lane}} non-2xx or failed",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "CPU utilisation of requests",
      "description": "What the reactive HPA sees.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"$lane\", container=\"demo-api\"}[1m])) / sum by (namespace) (kube_pod_container_resource_requests{namespace=~\"$lane\", container=\"demo-api\", resource=\"cpu\"})",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Forecast age",
      "description": "Seconds since the last successful forecast. Above ~90 s the forecast is treated as stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (lane) (pas_forecast_last_success_timestamp_seconds{lane=~\"$lane\"})",
          "legendFormat": "{{lane}}",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "stat",
      "title": "Forecast errors (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (lane) (increase(pas_forecast_errors_total{lane=~\"$lane\"}[1h]))",
          "legendFormat": "{{lane}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "stat",
      "title": "k6 dropped iterations (1h)",
      "description": "Non-zero means the load generator could not keep the arrival rate; that run is not valid.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (lane) (increase(k6_dropped_iterations_total{lane=~\"$lane\"}[1h]))",
          "legendFormat": "{{lane}}",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "stat",
      "title": "Ready replicas",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace) (kube_deployment_status_replicas_ready{namespace=~\"$lane\", deployment=\"demo-api\"})",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "id": 9
    }
  ]
}
